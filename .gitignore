# Terraform Local & Cache Files
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log

# Terraform Variable Files (Exclude sensitive secrets, keep template defaults)
*.tfvars
!terraform.tfvars
!environments/*.tfvars
*.tfvars.json

# Overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment Secrets
.env
.env.*
!.env.example

# Binaries, Executables & Large Archives
*.exe
*.dll
terraform_*_windows_amd64/
*.zip
*.tar.gz

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
